# Environment Variables Template
# Copy this file to .env and fill in your values

# Required: GitHub API Authentication
GITHUB_TOKEN=your-github-app-installation-token-here
GITHUB_REPO=owner/repo

# Required: Sentinel Bot Configuration
SENTINEL_BOT_LOGIN=your-bot-username

# Optional: Webhook Security
WEBHOOK_SECRET=your-webhook-secret-here

# Optional: Tuning
SENTINEL_POLL_INTERVAL=60
SENTINEL_HEARTBEAT_INTERVAL=300
LOG_LEVEL=INFO
